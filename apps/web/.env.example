# PostHog Analytics (optional)
# Get your keys at https://posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# OpenReel GPU cloud job worker (optional)
# Defaults to http://localhost:8000 in dev, https://ai.openreel.video otherwise.
VITE_OPENREEL_GPU_BASE_URL=

# OpenReel auth broker — mints short-lived GPU JWTs (optional)
# Defaults to http://localhost:8787 in dev, https://api.openreel.video otherwise.
VITE_OPENREEL_AUTH_BROKER_BASE_URL=
